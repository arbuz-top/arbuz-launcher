!ifndef LANG_POLISH
!define LANG_POLISH 0
!endif
LangString RunApp ${LANG_POLISH} "Uruchom program uruchamiający Arbuz"
LangString Desktop ${LANG_POLISH} "Utwórz skrót na pulpicie"
LangString AskData ${LANG_POLISH} "Usunąć także ustawienia, profile, światy i konta?"
LangString Busy ${LANG_POLISH} "Program uruchamiający działa. Zamknij i spróbuj ponownie."

!ifndef LANG_UKRAINIAN
!define LANG_UKRAINIAN 0
!endif
LangString RunApp ${LANG_UKRAINIAN} "Запустіть Arbuz Launcher"
LangString Desktop ${LANG_UKRAINIAN} "Створити ярлик на робочому столі"
LangString AskData ${LANG_UKRAINIAN} "Також видалити налаштування, профілі, світи та облікові записи?"
LangString Busy ${LANG_UKRAINIAN} "Пуск працює. Закрийте його та повторіть спробу."

!ifndef LANG_BELARUSIAN
