!insertmacro LANGFILE "Inuktitut" "Inuktitut" "Inuktitut" "Inuktitut"

!ifdef MUI_WELCOMEPAGE
  ${LangFileString} MUI_TEXT_WELCOME_INFO_TITLE "ᑐᙵᓱᒋᑦ $(^NameDA) ᐋᖅᑭᒃᓱᐃᓂᕐᒧᑦ"
  ${LangFileString} MUI_TEXT_WELCOME_INFO_TEXT "ᐋᖅᑭᒃᓱᐃᓂᖅ ᑐᑭᒧᐊᒃᑎᑦᑎᓂᐊᖅᑐᖅ ᐃᓕᖕᓂᒃ ᐋᖅᑭᒃᓱᐃᓂᕐᒥᒃ $(^NameDA).$\r$\n$\r$\nIt ᐊᑐᓕᖁᔭᐅᕗᖅ ᒪᑐᓯᓗᑎᑦ ᐊᓯᓕᒫᖏᓐᓂᒃ ᐊᑐᖅᑕᐅᕙᒃᑐᓂᒃ ᐱᒋᐊᓚᐅᙱᓐᓂᕐᓂ ᐋᖅᑭᒃᓱᐃᓂᕐᒥᒃ. ᑕᒪᓐᓇ ᐊᔪᕐᓇᕈᓐᓃᖅᑎᑦᑎᓂᐊᖅᑐᖅ ᓄᑖᙳᕆᐊᖅᑎᑦᑎᓂᕐᒥᒃ ᐊᑑᑎᖃᖅᑐᓂᒃ ᖃᕆᑕᐅᔭᕐᓄᑦ ᑎᑎᖅᑲᓂᒃ ᐱᒋᐊᖅᑎᑦᑎᒃᑲᓐᓂᕆᐊᖃᙱᓪᓗᓂ ᖃᕆᑕᐅᔭᕐᓂᒃ."
!endif

!ifdef MUI_UNWELCOMEPAGE
  ${LangFileString} MUI_UNTEXT_WELCOME_INFO_TITLE "ᑐᙵᓱᒋᑦ $(^NameDA) ᐲᔭᐃᓂᕐᒧᑦ"
  ${LangFileString} MUI_UNTEXT_WELCOME_INFO_TEXT "ᐋᖅᑭᒃᓱᐃᓂᖅ ᑐᑭᒧᐊᒃᑎᑦᑎᓂᐊᖅᑐᖅ ᐃᓕᖕᓂᒃ ᐲᔭᐃᓂᕐᒥᒃ $(^NameDA).$\r$\n$\r$\nBefore ᐱᒋᐊᖅᑎᑦᑎᓗᓂ ᐲᔭᐃᓂᕐᒥᒃ, ᖃᐅᔨᒪᑦᑎᐊᕆᑦ $(^NameDA) ᐃᖏᕐᕋᙱᒃᑲᓗᐊᕐᒪᖔᑦ."
!endif

