{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quarry Setup",
  "version": "1.0.0",
  "identifier": "app.quarry.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Установка Quarry",
        "width": 900,
        "height": 620,
        "resizable": false,
        "decorations": false,
        "center": true,
        "shadow": true,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
